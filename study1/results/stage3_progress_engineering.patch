+def main_progress(completed,total,run_start,initial_count,key):
+    """Operational progress only; never alters generation or analysis."""
+    now=datetime.now().astimezone()
+    elapsed=time.monotonic()-run_start
+    per_cell=elapsed/max(1,completed-initial_count)
+    remaining=max(0,total-completed)*per_cell
+    eta=now+timedelta(seconds=remaining)
+    message=f'Stage 3 Qwen: {completed}/{total} cells saved ({100*completed/total:.1f}%); latest {key}; remaining {remaining/3600:.2f} h; ETA {eta.strftime("%Y-%m-%d %H:%M %Z")}.'
+    print(f'{now.isoformat()} {message}',flush=True)
+    path=Path('STATUS.md')
+    contents=path.read_text()
+    summary=(f'**Stage 3 — Qwen only (Gemma pending).** {completed}/{total} cells saved. '
+             + (f'Estimated remaining time: {remaining/3600:.2f} hours; completion around {eta.strftime("%Y-%m-%d %H:%M %Z")}. ' if completed<total else 'Generation complete; integrity checks and Stage 4 analysis are next. ')
+             +'Approved v2.3 settings and the frozen analysis remain unchanged.')
+    contents=re.sub(r'^\*\*[^\n]+\*\*[^\n]*',lambda _:summary,contents,count=1,flags=re.M)
+    contents+=f'\n- {now.isoformat()}: {message}\n'
+    temporary=Path('STATUS.md.tmp')
+    temporary.write_text(contents)
+    temporary.replace(path)
