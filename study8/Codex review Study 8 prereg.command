#!/bin/bash
cd "$(dirname "$0")/.."
CODEX="/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"
"$CODEX" exec --skip-git-repo-check --sandbox read-only -C . "You are an independent reviewer. Read study8/Study8_ReactionFormation_PREREG_v0.1_draft.md and, for context, study7/data/main/RESULTS_SUMMARY.md, study7/Study7_Transformation_PREREG_v0.2_draft.md, study7/src/*.py, study3/src/*.py (trace generation, steering hooks, directions) and study4/src/runner.py. Do not edit files. Review: (1) feasibility of generating new steered traces in three system contexts with the Study 3 pulse protocol and the existing code; (2) which judge model could run locally on a 16 GB Mac alongside or after Qwen3-4B (check what models are cached in the repo or the Hugging Face cache), judge blinding, rubric parsing, calibration set and the second-judge agreement gate; (3) how to compute the layer-18 hostility projection on unsteered replay and whether it is meaningful given the trace itself contains hostile text; (4) estimands, RF1-RF3 conjunctions, multiplicity, power using Study 4/5 R1 variances, equivalence margins; (5) runtime and memory (Study 7 peaked near 11.6 GB) and anything missing for a binding preregistration. End with numbered required changes and optional suggestions." 2>&1 | tee study8/CODEX_REVIEW_v0.1.md
echo; echo "Done. You can close this window."
