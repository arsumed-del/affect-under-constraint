#!/bin/bash
# Independent read-only Codex review of the Study 7 v0.1 preregistration. Shows progress here and saves to CODEX_REVIEW_v0.1.md.
cd "$(dirname "$0")/.."
CODEX="/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"
"$CODEX" exec --skip-git-repo-check --sandbox read-only -C . "You are an independent reviewer. Read study7/Study7_Transformation_PREREG_v0.1_draft.md, and for context study5/ (Study5_RoleLadder_PREREG_v0.3.md, framings_s5.json, src/assembly.py, src/runner.py, analysis/analyze.py), study4/framings.json and study4/src/runner.py; inspect a few rows of study5/data/main/cells.jsonl but do not load it all. Do not edit any files. Review: (1) whether the design can be built from stored Study 4 trace token IDs with the instruction (warm vs no system message) varied only at replay, and whether warm-level R1 cells can reproduce Study 4/5 answers and ratings exactly given seeds and the system message; what changes to token construction the no-system condition implies (Qwen3 default system handling); (2) confounds: traces generated under the warm instruction then replayed without it (incoherence), O2 bystander question referent leakage, O3 self-satisfaction reflecting answer quality rather than self-directed hostility, classifier proxies for O4/O5, baseline shifts between instruction levels; (3) whether the Delta estimands and the conjunction/direction rules are correct and well-powered (use Study 5 R1 variances), multiplicity, equivalence margins for classifier outlets; (4) the reading table; (5) runtime and anything missing for a binding preregistration. End with a numbered list of required changes and a separate list of optional suggestions." 2>&1 | tee study7/CODEX_REVIEW_v0.1.md
echo; echo "Done. You can close this window."
